{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_content %}
    {% if page.extensions.twConfiguration.integration == 'javascript' or page.extensions.twConfiguration.integration == 'pluginstudio' %}
        <script>
            {% if page.extensions.twConfiguration.integration == 'pluginstudio' and page.extensions.twConfiguration.functionsInitialisationEnabled %}
                {% set languageKey = (page.header.activeLanguage.translationCode.code ?? context.languageInfo.localeCode)|split('-')[0]|escape %}
                window.addEventListener('twn.starter.ready', function () {
                    const params = new URLSearchParams(location.search);
                    tweakwiseListerPage({
                        query: params.get("tn_q"),
                        output: "#tweakwise-output-listing",
                        cid: "{{ md5(page.extensions.twConfiguration.rootCategoryId ~ '_' ~ page.extensions.twConfiguration.domainId) }}",
                        lang: "{{ languageKey }}",
                        parameters: "visibility=3%7C4",
                        on: {
                            {% sw_include '@Storefront/storefront/layout/tweakwise/pluginstudio-events.html.twig' %}
                        }
                    });
                });
            {% else %}
                window["twn-starter-config"]["output"] = '#tweakwise-output-listing';
                window["twn-starter-config"].parameters = "visibility=3%7C4";
            {% endif %}
        </script>
    {% endif %}

    <div id="tweakwise-output-listing"></div>

    {% if page.extensions.twConfiguration.eventTagEnabled %}
    <script>
        window.addEventListener('twSuccess', function (e) {
            const searchTerm = e?.detail?.data?.properties?.searchterm;
            if (searchTerm === undefined) {
                return;
            }

            if (!window.tweakwise || typeof window.tweakwise.getProfileKey !== 'function') {
                return;
            }

            window.tweakwiseLayer = window.tweakwiseLayer || [];
            window.tweakwiseLayer.push({
                event: 'search',
                data: {
                    searchTerm: searchTerm
                }
            });
        });
    </script>
    {% endif %}
{% endblock %}
