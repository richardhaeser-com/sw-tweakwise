<div :isLoading="isLoading" class="tweakwise-sync">

    <sw-modal
        v-if="showVariantSyncConfirm"
        :title="$tc(variantSyncConfirmTitleKey)"
        @modal-close="onCancelVariantSync"
    >
        <p>{{ $tc(variantSyncConfirmMessageKey) }}</p>
        <template #modal-footer>
            <mt-button variant="ghost" @click="onCancelVariantSync">
                {{ $tc('sw-product.detail.tab.syncVariantsCancelButton') }}
            </mt-button>
            <mt-button variant="primary" :isLoading="syncingFeedId !== null" @click="onConfirmVariantSync">
                {{ $tc(variantSyncConfirmButtonKey) }}
            </mt-button>
        </template>
    </sw-modal>

    <sw-container v-if="product && product.childCount">
        <mt-banner
                variant="attention"
                class="sw-bulk-edit-save-modal__warning"
        >
            {{ $tc('sw-product.detail.tab.variants') }}
        </mt-banner>
    </sw-container>

    <template v-for="frontend in frontends">
        <sw-card :title="frontend.name" v-if="frontend.accessToken && frontend.backendSyncEnabled">
            <sw-container
                    columns="1fr 1fr"
                    gap="10px 30px"
            >
                <div>
                    {{ $tc('sw-product.detail.tab.productId') }}
                </div>
                <div>
                    {{ productId[frontend.id] }}
                </div>
                <div>
                    {{ $tc('sw-product.detail.tab.available') }}
                </div>
                <div>
                    <span v-if="availability[frontend.id]">{{ $tc('sw-product.detail.tab.availableYes') }}</span>
                    <span v-else>{{ $tc('sw-product.detail.tab.availableNo') }}</span>
                </div>
                <div v-if="availability[frontend.id]">
                    {{ $tc('sw-product.detail.tab.lastModified') }}
                </div>
                <div v-if="availability[frontend.id]">
                    <sw-time-ago
                            :date="new Date(tweakwiseData[frontend.id].LastModified)"
                            :date-time-format="{ month: '2-digit', day: '2-digit' }"
                    />
                </div>
            </sw-container>

            <template v-if="feedsPerFrontend[frontend.id] && feedsPerFrontend[frontend.id].length > 0">
                <div class="tweakwise-feeds__title">
                    {{ $tc('sw-product.detail.tab.feedsTitle') }}
                </div>
                <div
                    v-for="feed in feedsPerFrontend[frontend.id]"
                    :key="feed.id"
                    class="tweakwise-feeds__row"
                >
                    <span>{{ feed.name }}</span>
                    <mt-button
                        size="small"
                        variant="primary"
                        :isLoading="syncingFeedId === feed.id"
                        :disabled="syncingFeedId !== null && syncingFeedId !== feed.id"
                        @click="onSyncForFeed(frontend.id, feed.id, feed.groupedProducts)"
                    >
                        {{ $tc('sw-product.detail.tab.syncForFeed') }}
                    </mt-button>
                </div>
            </template>
        </sw-card>

        <sw-card :title="frontend.name" v-if="!frontend.accessToken">
            <mt-banner
                    variant="attention"
                    class="sw-bulk-edit-save-modal__warning"
            >
                {{ $tc('sw-product.detail.tab.noAccessToken') }}
            </mt-banner>
        </sw-card>
    </template>
</div>
