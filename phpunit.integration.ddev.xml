<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/TestBootstrap.php"
         cacheResult="false">
    <php>
        <env name="APP_DEBUG" value="1"/>
        <env name="APP_ENV" value="test"/>
        <env name="APP_SECRET" value="s$cretf0rt3st"/>
        <env name="KERNEL_CLASS" value="Shopware\Core\Kernel"/>
        <env name="LOCK_DSN" value="flock"/>
        <env name="SHELL_VERBOSITY" value="-1"/>
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="weak"/>
        <ini name="error_reporting" value="E_ALL"/>
        <env name="DATABASE_URL" value="mysql://root:root@db:3306/shopware_test" force="true"/>
        <ini name="PROJECT_ROOT" value="/var/www/html/"/>
    </php>
    <testsuites>
        <testsuite name="Tweakwise Integration tests">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./src</directory>
        </include>
    </source>
</phpunit>
